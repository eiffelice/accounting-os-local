{
  "mcpServers": {
    "accounting-os-local": {
      "command": "npm",
      "args": ["run", "dev:mcp"],
      "cwd": "C:\\PATH\\TO\\accounting-os-local",
      "env": {
        "DATABASE_URL": "postgresql://accounting:<from-.env>@127.0.0.1:5432/accounting_os",
        "ACCOUNTING_MCP_IDENTITY_ID": "<from-bootstrap-output>",
        "ACCOUNTING_MCP_TOKEN": "<from-bootstrap-output>"
      }
    }
  }
}
